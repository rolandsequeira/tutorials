# ---- Server ----
PORT=8080
# Public HTTPS origin of this server (no trailing slash). Used in the embedded script and dashboard.
BASE_URL=https://notice.example.com
# SQLite file location (mount a volume here in Docker)
DB_PATH=./data/app.db
# Brand shown in the "Powered by" line on free-plan notices and in the dashboard
APP_NAME=Ad Blocker Notice
LANDING_URL=https://coderscreation.com/

# ---- Wix Dev Center (https://dev.wix.com -> your app) ----
# OAuth page: App ID and App Secret Key
WIX_APP_ID=
WIX_APP_SECRET=
# Webhooks page: "Public key" (PEM). Newlines may be written as \n.
WIX_PUBLIC_KEY=
# Pricing page: map your plan (vendor product) IDs to internal plans. JSON object.
# Example: {"pro_monthly_plan_id":"pro","pro_yearly_plan_id":"pro"}
WIX_PLAN_MAP={}

# ---- Local development ----
# DEV_MODE=1 enables /demo and lets the dashboard run with ?instanceId=dev-site (no Wix signature).
# NEVER enable in production.
DEV_MODE=0
