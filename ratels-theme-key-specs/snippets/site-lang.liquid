{%- comment -%}
  Outputs the site language: 'sv' or 'en'.
  The domain decides first, so www.ratelsgroup.se is always Swedish and www.ratelsgroup.com is always English.
  On any other host (theme preview, myshopify.com) the visitor's Shopify language is used.

  Usage:
  {%- capture site_lang -%}{% render 'site-lang' %}{%- endcapture -%}
{%- endcomment -%}
{%- liquid
  assign host = request.host | downcase
  assign lang = 'en'
  if request.locale.iso_code == 'sv'
    assign lang = 'sv'
  endif
  if host == 'ratelsgroup.se' or host == 'www.ratelsgroup.se'
    assign lang = 'sv'
  elsif host == 'ratelsgroup.com' or host == 'www.ratelsgroup.com'
    assign lang = 'en'
  endif
-%}
{{- lang -}}
