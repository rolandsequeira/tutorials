{%- comment -%}
  Outputs the site language: 'sv' or 'en'.
  Follows the visitor's Shopify language, so ratelsgroup.com/sv (and ratelsgroup.se, if it serves the store) is Swedish,
  and ratelsgroup.com is English.

  Usage:
  {%- capture site_lang -%}{% render 'site-lang' %}{%- endcapture -%}
{%- endcomment -%}
{%- liquid
  assign host = request.host | downcase
  assign lang = 'en'
  if request.locale.iso_code == 'sv'
    assign lang = 'sv'
  elsif host == 'ratelsgroup.se' or host == 'www.ratelsgroup.se'
    assign lang = 'sv'
  endif
-%}
{{- lang -}}
