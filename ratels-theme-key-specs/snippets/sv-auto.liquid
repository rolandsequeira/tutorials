{%- comment -%}
  Swedish fallback for English theme texts, used on the Swedish site when a "(Svenska)" field is empty.
  Matches the whole text (case-insensitive). ALL-CAPS English gives ALL-CAPS Swedish.
  Unknown texts are returned unchanged. Add new phrases to the case list below.
  Accepts: text {String}
{%- endcomment -%}
{%- liquid
  assign src = text | strip
  assign key = src | downcase
  assign out = ''
  case key
    when 'powerful machines.'
      assign out = 'Kraftfulla maskiner.'
    when 'personal service.'
      assign out = 'Personlig service.'
    when 'high performance machines for every job. backed by personal service you can rely on – before, during and after the sale.'
      assign out = 'Högpresterande maskiner för varje jobb. Med personlig service du kan lita på – före, under och efter köpet.'
    when 'get a quote'
      assign out = 'Begär offert'
    when 'get your quote'
      assign out = 'Begär offert'
    when 'contact us'
      assign out = 'Kontakta oss'
    when 'quality you can trust'
      assign out = 'Kvalitet du kan lita på'
    when 'built for durability and long-term performance.'
      assign out = 'Byggda för hållbarhet och lång livslängd.'
    when 'expert support'
      assign out = 'Expertsupport'
    when 'personal service from real people.'
      assign out = 'Personlig service från riktiga människor.'
    when 'ready when you are'
      assign out = 'Redo när du är'
    when 'machines and parts in stock.'
      assign out = 'Maskiner och reservdelar i lager.'
    when 'popular categories'
      assign out = 'Populära kategorier'
    when 'loaders'
      assign out = 'Lastmaskiner'
    when 'excavators'
      assign out = 'Grävmaskiner'
    when 'parts'
      assign out = 'Reservdelar'
    when 'spare parts'
      assign out = 'Reservdelar'
    when 'electric machines'
      assign out = 'Elektriska maskiner'
    when 'attachments'
      assign out = 'Redskap'
    when 'forestry'
      assign out = 'Skogsbruk'
    when 'forestry & agriculture'
      assign out = 'Skogsbruk & lantbruk'
    when 'agriculture'
      assign out = 'Lantbruk'
    when 'agricultural machines'
      assign out = 'Lantmaskiner'
    when 'other'
      assign out = 'Annat'
    when 'loaders - heracles'
      assign out = 'Lastmaskiner - Heracles'
    when 'excavators - rhinoceros'
      assign out = 'Grävmaskiner - Rhinoceros'
    when 'forestry - metsa'
      assign out = 'Skogsbruk - Metsa'
    when 'featured machines'
      assign out = 'Utvalda maskiner'
    when 'download pdf'
      assign out = 'Ladda ner PDF'
    when 'download data sheet'
      assign out = 'Ladda datablad'
    when 'see all machines'
      assign out = 'Se alla maskiner'
    when 'view all'
      assign out = 'Visa alla'
    when 'need a machine?'
      assign out = 'Behöver du en maskin?'
    when 'tell us what you need and we will send you the best offer'
      assign out = 'Berätta vad du behöver så skickar vi dig det bästa erbjudandet'
    when 'tell us what you need and we will send you the best offer.'
      assign out = 'Berätta vad du behöver så skickar vi dig det bästa erbjudandet.'
    when 'tell us what you need and we will send you a proposal.'
      assign out = 'Berätta mer vad du har behov av och vi skickar dig ett förslag.'
    when 'your partner for heavy machinery'
      assign out = 'Din partner för tunga maskiner'
    when 'quality and service.'
      assign out = 'Kvalitet och service.'
    when 'quality in focus'
      assign out = 'Kvalitet i fokus'
    when 'nationwide service'
      assign out = 'Rikstäckande service'
    when 'tailored solutions'
      assign out = 'Skräddarsydda lösningar'
    when 'machines in action'
      assign out = 'Maskiner i arbete'
    when 'see the machines in action'
      assign out = 'Se maskinerna i arbete'
    when 'rtl ratels provide the best services'
      assign out = 'RTL Ratels ger den bästa servicen'
    when 'rtl ratels provide the best service'
      assign out = 'RTL Ratels ger den bästa servicen'
    when 'we got the right machine at the right price, and fast support when we needed it.'
      assign out = 'Vi fick rätt maskin till rätt pris och snabb support när vi behövde det.'
    when 'anders, entrepreneur'
      assign out = 'Anders, entreprenör'
    when 'machines. attachments. solutions. powerful machines. personal service.'
      assign out = 'Maskiner. Redskap. Lösningar. Kraftfulla maskiner. Personlig service.'
    when 'links'
      assign out = 'Länkar'
    when 'quick links'
      assign out = 'Snabblänkar'
    when 'contact'
      assign out = 'Kontakt'
    when 'follow us'
      assign out = 'Följ oss'
    when 'ratels group ab. all rights reserved.'
      assign out = 'Ratels Group AB. Alla rättigheter förbehållna.'
  endcase
  if out == ''
    # Video titles like "Heracles H580 - In Action"
    if key contains ' - in action'
      assign out = src | replace: ' - In Action', ' – i arbete' | replace: ' - IN ACTION', ' – I ARBETE' | replace: ' - in action', ' – i arbete'
    else
      assign out = src
    endif
  else
    assign src_upper = src | upcase
    if src == src_upper
      assign out = out | upcase
    endif
  endif
-%}
{{- out -}}
