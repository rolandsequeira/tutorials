{%- capture site_lang -%}{% render 'site-lang' %}{%- endcapture -%}
{{ 'theme-rtl.css' | asset_url | stylesheet_tag }}

<div class="machinery-collection-container page-width section-padding">
  
  <header class="collection-header">
    <h1 class="collection-title">{{ collection.title }}</h1>
    {% if collection.description != blank %}
      <div class="collection-description">{{ collection.description }}</div>
    {% endif %}
  </header>

  <div class="machinery-grid-wrapper">
    
    <aside class="collection-sidebar">
      <div class="filter-box">
        <h3 class="filter-title">{% if site_lang == 'sv' %}KATEGORIER{% else %}CATEGORIES{% endif %}</h3>
        <ul class="filter-list">
          {% for link in linklists.categories.links %}
             <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {% endfor %}
        </ul>
      </div>
    </aside>

    <main class="collection-grid" id="ProductGridContainer">
      {% paginate collection.products by section.settings.products_per_page %}
        
        {%- if section.settings.enable_sorting -%}
          <div class="collection-sort-header">
            <span class="product-count">{{ collection.products_count }} {% if site_lang == 'sv' %}produkter{% else %}products{% endif %}</span>
            <div class="sort-wrapper">
              <label for="SortBy">{% if site_lang == 'sv' %}Sortera efter:{% else %}Sort by:{% endif %}</label>
              <select name="sort_by" id="SortBy" class="sort-select" onchange="location = this.value;">
                {%- for option in collection.sort_options -%}
                  <option value="?sort_by={{ option.value }}" {% if option.value == collection.sort_by %}selected="selected"{% endif %}>
                    {{ option.name }}
                  </option>
                {%- endfor -%}
              </select>
            </div>
          </div>
        {%- endif -%}

        {% if collection.products.size == 0 %}
          <div class="empty-collection text-center mt-40">
            <p>{% if site_lang == 'sv' %}Inga maskiner hittades i den här kategorin.{% else %}No machines found in this category.{% endif %}</p>
          </div>
        {% else %}
          
          <div class="grid-products">
            {% for product in collection.products %}
              {%- capture spec_group -%}{% render 'machine-key-specs', lang: site_lang, product: product, collection_handle: collection.handle, output: 'group' %}{%- endcapture -%}
              <div class="machinery-product-card machinery-product-card--{{ spec_group | strip }}">
                
                <a href="{{ product.url | within: collection }}" class="card-image-link">
                  <div class="card-image-wrapper">
                    {% if product.featured_image != blank %}
                      <img src="{{ product.featured_image | image_url: width: 600 }}" 
                           alt="{{ product.featured_image.alt | escape }}" 
                           loading="lazy" 
                           class="product-image">
                    {% else %}
                      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    {% endif %}
                    
                    {% comment %} Stripped piping from emission standard {% endcomment %}
                    {% if product.metafields.custom.emission_standard != blank %}
                       <span class="card-badge">{{ product.metafields.custom.emission_standard | string | split: '|' | first }}</span>
                    {% endif %}
                  </div>
                </a>

                <div class="card-info">
                  <div class="card-vendor">{{ product.vendor | default: 'RATELS GROUP' }}</div>
                  <h3 class="card-title">
                    <a href="{{ product.url | within: collection }}">{{ product.title }}</a>
                  </h3>
                  
                  {% comment %} Key specs vary by category - see snippets/machine-key-specs.liquid {% endcomment %}
                  {% render 'machine-key-specs', lang: site_lang, product: product, collection_handle: collection.handle %}

                  <div class="card-bottom">
                    <div class="card-price">{{ product.price | money }}</div>
<a href="{{ product.url }}" class="btn btn--red btn--full-width-cta" style="display: block; text-align: center;">
    {% if site_lang == 'sv' %}BEGÄR OFFERT{% else %}GET YOUR QUOTE{% endif %}
  </a>
                    
                  </div>
                </div>

              </div>
            {% endfor %}
          </div>

          {% if paginate.pages > 1 %}
            <div class="pagination-wrapper text-center mt-40">
              {{ paginate | default_pagination }}
            </div>
          {% endif %}

        {% endif %}
      {% endpaginate %}
    </main>

  </div>
</div>

<style>
/* ==========================================================================
   COLLECTION GRID SPECIFIC CSS
   ========================================================================== */
.collection-header {
  margin-bottom: 40px;
  border-bottom: 3px solid var(--color-red);
  padding-bottom: 20px;
}

.collection-title {
  font-family: var(--font-heading);
  font-size: 36px;
  font-weight: 900;
  color: var(--color-black);
  margin: 0;
  text-transform: uppercase;
  letter-spacing: -0.5px;
}

.machinery-grid-wrapper {
  display: grid;
  grid-template-columns: 250px 1fr;
  gap: 40px;
  align-items: start;
}

/* Sorting Header */
.collection-sort-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--color-gray-light);
  padding: 10px 20px;
  border: 1px solid var(--color-border);
  margin-bottom: 30px;
  border-radius: 4px;
}
.product-count {
  font-weight: 700;
  color: var(--color-black);
}
.sort-wrapper label {
  font-size: 13px;
  font-weight: 700;
  margin-right: 10px;
}
.sort-select {
  padding: 8px 12px;
  border: 1px solid var(--color-border);
  border-radius: 2px;
  font-family: inherit;
}

/* Sidebar Styling */
.filter-box {
  background: var(--color-gray-light);
  border: 1px solid var(--color-border);
  padding: 20px;
  border-radius: 4px;
}
.filter-title {
  font-family: var(--font-heading);
  font-size: 16px;
  margin: 0 0 15px 0;
  color: var(--color-black);
  border-bottom: 2px solid var(--color-red);
  padding-bottom: 10px;
}
.filter-list {
  list-style: none;
  padding: 0;
  margin: 0;
}
.filter-list li { margin-bottom: 10px; }
.filter-list a {
  color: var(--color-dark);
  text-decoration: none;
  font-weight: 500;
  font-size: 14px;
  transition: color 0.2s;
}
.filter-list a:hover { color: var(--color-red); }

/* Grid layout */
.grid-products {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

/* Product Card Styling */
.machinery-product-card {
  background: var(--color-white);
  border: 1px solid var(--color-gray-light);
  border-radius: 4px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: border-color 0.3s, box-shadow 0.3s;
}
.machinery-product-card:hover {
  border-color: var(--color-red);
  box-shadow: 0 5px 15px rgba(0,0,0,0.08);
}

.card-image-wrapper {
  position: relative;
  background: var(--color-gray-light);
  padding: 20px;
  height: 240px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.product-image {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
}
.card-badge {
  position: absolute;
  top: 10px;
  right: 10px;
  background: var(--color-black);
  color: var(--color-white);
  padding: 4px 8px;
  font-size: 11px;
  font-weight: 800;
  text-transform: uppercase;
}

.card-info {
  padding: 20px;
  display: flex;
  flex-direction: column;
  flex-grow: 1;
}
.card-vendor {
  font-size: 11px;
  color: #777;
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 5px;
}
.card-title {
  margin: 0 0 15px 0;
  font-size: 18px;
  line-height: 1.3;
}
.card-title a { color: var(--color-black); }
.card-title a:hover { color: var(--color-red); }

/* Specs layout inside card */
.card-quick-specs {
  margin-bottom: 20px;
  padding-bottom: 15px;
  border-bottom: 1px dotted var(--color-gray-light);
  flex-grow: 1;
}
.spec-line {
  display: flex;
  justify-content: space-between;
  font-size: 13px;
  margin-bottom: 6px;
}
.spec-line .spec-label { color: #666; }
.spec-line .spec-value { color: var(--color-black); font-weight: 700; }

.card-price {
  font-size: 20px;
  font-weight: 800;
  color: var(--color-red);
  margin-bottom: 15px;
}

.collection-quick-add {
  margin-top: auto;
}

/* Mobile Breakpoints */
@media (max-width: 1024px) {
  .grid-products { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 768px) {
  .machinery-grid-wrapper { grid-template-columns: 1fr; }
  .collection-sidebar { display: none; }
  .collection-sort-header { flex-direction: column; gap: 15px; align-items: flex-start; }
}
@media (max-width: 480px) {
  .grid-products { grid-template-columns: 1fr; }
}
</style>

{% schema %}
{
  "name": "Machinery Collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 6,
      "max": 36,
      "step": 3,
      "default": 12,
      "label": "Products per page"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "Enable sorting"
    }
  ]
}
{% endschema %}