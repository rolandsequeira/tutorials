    {
      "type": "header",
      "content": "Feature 2"
    },
    {
      "type": "text",
      "id": "feature2_icon",
      "label": "Feature 2 Icon",
      "default": "👤"
    },
    {
      "type": "text",
      "id": "feature2_title",
      "label": "Feature 2 Title",
      "default": "EXPERT SUPPORT"
    },
    {
      "type": "text",
      "id": "feature2_title_sv",
      "label": "Feature 2 Title (Svenska)"
    },
    {
      "type": "inline_richtext",
      "id": "feature2_text",
      "label": "Feature 2 Text",
      "default": "Personal service from real people."
    },
    {
      "type": "inline_richtext",
      "id": "feature2_text_sv",
