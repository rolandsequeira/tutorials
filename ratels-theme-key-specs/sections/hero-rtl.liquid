    },
    {
      "type": "text",
      "id": "feature1_icon",
      "label": "Feature 1 Icon",
      "default": "🛡️"
    },
    {
      "type": "text",
      "id": "feature1_title",
      "label": "Feature 1 Title",
      "default": "QUALITY YOU CAN TRUST"
    },
    {
      "type": "text",
      "id": "feature1_title_sv",
      "label": "Feature 1 Title (Svenska)"
    },
    {
      "type": "inline_richtext",
      "id": "feature1_text",
      "label": "Feature 1 Text",
      "default": "Built for durability and long-term performance."
    },
    {
      "type": "inline_richtext",
      "id": "feature1_text_sv",
      "label": "Feature 1 Text (Svenska)"
