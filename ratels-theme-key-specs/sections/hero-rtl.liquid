{%- capture site_lang -%}{% render 'site-lang' %}{%- endcapture -%}
{%- comment -%} Each text has an English field and a Swedish (_sv) field; the Swedish one is used on the Swedish site when filled in. {%- endcomment -%}
{%- liquid
  assign t_title_main = section.settings.title_main
  if site_lang == 'sv' and section.settings.title_main_sv != blank
    assign t_title_main = section.settings.title_main_sv
  endif
  assign t_title_colored = section.settings.title_colored
  if site_lang == 'sv' and section.settings.title_colored_sv != blank
    assign t_title_colored = section.settings.title_colored_sv
  endif
  assign t_subtext = section.settings.subtext
  if site_lang == 'sv' and section.settings.subtext_sv != blank
    assign t_subtext = section.settings.subtext_sv
  endif
  assign t_btn_text = section.settings.btn_text
  if site_lang == 'sv' and section.settings.btn_text_sv != blank
    assign t_btn_text = section.settings.btn_text_sv
  endif
  assign t_feature1_title = section.settings.feature1_title
  if site_lang == 'sv' and section.settings.feature1_title_sv != blank
    assign t_feature1_title = section.settings.feature1_title_sv
  endif
  assign t_feature1_text = section.settings.feature1_text
  if site_lang == 'sv' and section.settings.feature1_text_sv != blank
    assign t_feature1_text = section.settings.feature1_text_sv
  endif
  assign t_feature2_title = section.settings.feature2_title
  if site_lang == 'sv' and section.settings.feature2_title_sv != blank
    assign t_feature2_title = section.settings.feature2_title_sv
  endif
  assign t_feature2_text = section.settings.feature2_text
  if site_lang == 'sv' and section.settings.feature2_text_sv != blank
    assign t_feature2_text = section.settings.feature2_text_sv
  endif
  assign t_feature3_title = section.settings.feature3_title
  if site_lang == 'sv' and section.settings.feature3_title_sv != blank
    assign t_feature3_title = section.settings.feature3_title_sv
  endif
  assign t_feature3_text = section.settings.feature3_text
  if site_lang == 'sv' and section.settings.feature3_text_sv != blank
    assign t_feature3_text = section.settings.feature3_text_sv
  endif
-%}
<div class="hero-rtl" style="background-color: #1a1a1a; background-image: url('{{ section.settings.bg_image | img_url: 'master' }}');">
  <div class="hero-overlay"></div>
  <div class="page-width hero-content-wrapper">
    <div class="hero-text-box">
      
      <h1 class="hero-title">
        {{ t_title_main }}<br>
        <span class="text-red">{{ t_title_colored }}</span>
      </h1>
      
      {%- if t_subtext != blank -%}
        <p class="hero-subtext">{{ t_subtext }}</p>
      {%- endif -%}
      
      {% comment %} HERO CTA BUTTON {% endcomment %}
      {%- if t_btn_text != blank -%}
        <a href="{{ section.settings.btn_link | default: pages.contact.url }}" class="btn btn--red" style="margin-top: 20px; display: inline-block;">
          {{ t_btn_text }}
        </a>
      {%- endif -%}
      
      <div class="hero-features">
        <div class="feature-item">
          <div class="feature-icon">{{ section.settings.feature1_icon }}</div>
          <div class="feature-text">
            <strong>{{ t_feature1_title }}</strong>
            <span>{{ t_feature1_text }}</span>
          </div>
        </div>
        <div class="feature-item">
          <div class="feature-icon">{{ section.settings.feature2_icon }}</div>
          <div class="feature-text">
            <strong>{{ t_feature2_title }}</strong>
            <span>{{ t_feature2_text }}</span>
          </div>
        </div>
        <div class="feature-item">
          <div class="feature-icon">{{ section.settings.feature3_icon }}</div>
          <div class="feature-text">
            <strong>{{ t_feature3_title }}</strong>
            <span>{{ t_feature3_text }}</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "RTL Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "title_main",
      "label": "Heading (White Text)",
      "default": "POWERFUL MACHINES."
    },
    {
      "type": "text",
      "id": "title_main_sv",
      "label": "Heading (White Text) (Svenska)"
    },
    {
      "type": "text",
      "id": "title_colored",
      "label": "Heading (Red Highlighted Text)",
      "default": "PERSONAL SERVICE."
    },
    {
