      "default": "READY WHEN YOU ARE"
    },
    {
      "type": "text",
      "id": "feature3_title_sv",
      "label": "Feature 3 Title (Svenska)"
    },
    {
      "type": "inline_richtext",
      "id": "feature3_text",
