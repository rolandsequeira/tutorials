{%- capture site_lang -%}{% render 'site-lang' %}{%- endcapture -%}
{%- comment -%} Each text has an English field and a Swedish (_sv) field. On the Swedish site the _sv field is used; if it is empty, snippets/sv-auto.liquid translates the English text. {%- endcomment -%}
{%- liquid
  assign t_title = section.settings.title
  if site_lang == 'sv'
    if section.settings.title_sv != blank
      assign t_title = section.settings.title_sv
    else
      capture t_title
        render 'sv-auto', text: section.settings.title
      endcapture
    endif
  else
    capture t_title
      render 'en-auto', text: section.settings.title
    endcapture
  endif
  assign t_text = section.settings.text
  if site_lang == 'sv'
    if section.settings.text_sv != blank
      assign t_text = section.settings.text_sv
    else
      capture t_text
        render 'sv-auto', text: section.settings.text
      endcapture
    endif
  else
    capture t_text
      render 'en-auto', text: section.settings.text
    endcapture
  endif
  assign t_button_text = section.settings.button_text
  if site_lang == 'sv'
    if section.settings.button_text_sv != blank
      assign t_button_text = section.settings.button_text_sv
    else
      capture t_button_text
        render 'sv-auto', text: section.settings.button_text
      endcapture
    endif
  else
    capture t_button_text
      render 'en-auto', text: section.settings.button_text
    endcapture
  endif
-%}
<div class="cta-banner-rtl page-width">
  <div class="cta-inner">
    <div class="cta-content">
      <h2>{{ t_title }}</h2>
      <p>{{ t_text }}</p>
      <a href="{{ section.settings.button_link }}" class="btn btn--red">{{ t_button_text }}</a>
    </div>
    <div class="cta-image" style="background-color: #2a2a2a; background-image: url('{{ section.settings.image | img_url: '800x' }}');">
    </div>
  </div>
</div>
{% schema %}
{
  "name": "RTL CTA Banner",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "NEED A MACHINE?"
    },
    {
      "type": "text",
      "id": "title_sv",
      "label": "Heading (Svenska – leave empty to auto-translate)"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Tell us what you need and we will send you a proposal."
    },
    {
      "type": "textarea",
      "id": "text_sv",
      "label": "Text (Svenska – leave empty to auto-translate)"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Label",
      "default": "GET A QUOTE"
    },
    {
      "type": "text",
      "id": "button_text_sv",
      "label": "Button Label (Svenska – leave empty to auto-translate)"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Right Side Image"
    }
  ],
  "presets": [
    {
      "name": "RTL CTA Banner"
    }
  ]
}
{% endschema %}