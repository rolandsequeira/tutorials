<style>
/* Target the ul inside the main container to remove default styling */
.equipment-highlights-box ul {
  list-style-type: none;
  padding-left: 0;
  margin: 0;
}

/* Style the list items to create space for the checkmark */
.equipment-highlights-box ul li {
  position: relative;
  padding-left: 24px;
  margin-bottom: 8px;
  line-height: 1.5;
}

/* Insert the checkmark using a pseudo-element */
.equipment-highlights-box ul li::before {
  content: "✓";
  position: absolute;
  left: 0;
  top: 0;
  color: #2e7d32;
  font-weight: bold;
}
</style>

<script>
function switchMachineryTab(evt, tabId) {
  var i, tabcontent, tablinks;
  tabcontent = document.getElementsByClassName("machinery-tab-content");
  for (i = 0; i < tabcontent.length; i++) {
    tabcontent[i].style.display = "none";
  }
  tablinks = document.getElementsByClassName("tab-link");
  for (i = 0; i < tablinks.length; i++) {
    tablinks[i].className = tablinks[i].className.replace(" active-tab", "");
  }
  document.getElementById(tabId).style.display = "block";
  evt.currentTarget.className += " active-tab";
}

document.addEventListener("DOMContentLoaded", function() {
  window.galleryUrls = Array.from(document.querySelectorAll('#GalleryData .gallery-url')).map(el => el.innerText);
});

function moveGallery(direction) {
  if (!window.galleryUrls || window.galleryUrls.length <= 1) return;
  var imgElement = document.getElementById('SliderMainImage');
  var currentIndex = parseInt(imgElement.getAttribute('data-index'));
  var maxIndex = window.galleryUrls.length - 1;
  var nextIndex = currentIndex + direction;
  
  if (nextIndex < 0) nextIndex = maxIndex;
  if (nextIndex > maxIndex) nextIndex = 0;
  
  imgElement.src = window.galleryUrls[nextIndex];
  imgElement.setAttribute('data-index', nextIndex);
}
</script>

