{{ 'component-machinery-product.css' | asset_url | stylesheet_tag }}

<div class="machinery-full-page-container">
  
  <div class="page-width machinery-top-grid-2col">
    
    <div class="machinery-details-pane">
      <h1 class="machinery-page-title">{{ product.title }}</h1>
      
      {% comment %} Highlights Box - Strips pipes out to just show text {% endcomment %}
      {% if product.metafields.custom.top_text != blank %}
      <div class="equipment-highlights-box">
          {{ product.metafields.custom.top_text | newline_to_br }}
        </div>
      {% endif %}

      <div class="machinery-tabs-nav">
        <button class="tab-link active-tab" onclick="switchMachineryTab(event, 'prod-desc')">
          ⭕ {% if request.locale.iso_code == 'sv' %}Produktbeskrivning{% else %}Product Description{% endif %}
        </button>
      </div>

      <div id="prod-desc" class="machinery-tab-content current-content">
        {{ product.description }}
      </div>
      
      {% comment %} REPLACED SOLD OUT FORM WITH GET QUOTE LINK {% endcomment %}
      <a href="{{ pages.contact.url }}" class="btn btn--red btn--full-width-cta" style="display: block; text-align: center;">
        {% if request.locale.iso_code == 'sv' %}BEGÄR OFFERT{% else %}GET YOUR QUOTE{% endif %}
      </a>
    </div>

    <div class="machinery-sidebar-pane">
      
      <div class="slider-container" style="margin-bottom: 30px;">
        {% if product.images.size > 1 %}
          <button type="button" class="slider-arrow arrow-prev" onclick="moveGallery(-1)" aria-label="Previous">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
          </button>
        {% endif %}

        <div class="slider-image-wrapper">
          <img id="SliderMainImage" src="{{ product.featured_image | image_url: width: 1000 }}" alt="{{ product.title }}" data-index="0">
        </div>

        {% if product.images.size > 1 %}
          <button type="button" class="slider-arrow arrow-next" onclick="moveGallery(1)" aria-label="Next">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        {% endif %}
      </div>

      <div id="GalleryData" style="display:none;">
        {% for image in product.images %}
          <span class="gallery-url">{{ image | image_url: width: 1000 }}</span>
        {% endfor %}
      </div>

      <div class="machinery-main-price">
        {{ product.price | money }}
        <span class="price-tax-subtext">
          {% if request.locale.iso_code == 'sv' %}Exkl. moms och frakt{% else %}Excl. tax and shipping{% endif %}
        </span>
      </div>

      <div class="sticky-sidebar-wrapper">
        <div class="sidebar-red-card">
          <div class="red-card-header">
            <span class="header-book-icon">📋</span> 
            {% if request.locale.iso_code == 'sv' %}Nyckelegenskaper{% else %}Key Attributes{% endif %}
          </div>
          
          {% comment %}
            RED CARD: category key specs (snippets/machine-key-specs.liquid) as tiles on top,
            then remaining flagged attributes (middle value parts[1] == '1'), minus the ones already shown.
          {% endcomment %}
          {%- capture key_spec_keys -%}{% render 'machine-key-specs', product: product, collection_handle: collection.handle, output: 'keys' %}{%- endcapture -%}
          {%- assign key_spec_keys = key_spec_keys | strip | split: ',' -%}
          <div class="red-card-body">
            {% render 'machine-key-specs', product: product, collection_handle: collection.handle, output: 'tiles' %}
            {% for field in product.metafields.custom %}
              {% assign val_str = field.last | string %}
              {% assign parts = val_str | split: '|' %}
              {% if parts[1] == '1' and key_spec_keys contains field.first %}{% continue %}{% endif %}
              {% if parts[1] == '1' %}
                {% assign t_key = 'specs.' | append: field.first %}
                {% assign translated_title = t_key | t %}
                {% if translated_title contains 'translation missing' %}
                  {% assign translated_title = field.first | replace: '_', ' ' | capitalize %}
                {% endif %}
                <div class="sidebar-data-row">
                  <span class="lbl">{{ translated_title }}:</span>
                  <span class="val">{{ parts[0] }}</span>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>

        {% comment %} DYNAMIC METAFIELD BUTTONS {% endcomment %}
        {% if product.metafields.custom.product_catalog != blank %}
          <a href="{{ product.metafields.custom.product_catalog.value.url }}" target="_blank" class="btn btn--black-download btn--full-width-cta">
            📥 {% if request.locale.iso_code == 'sv' %}LADDA NER BROSCHYR{% else %}DOWNLOAD BROCHURE{% endif %}
          </a>
        {% endif %}

        {% if product.metafields.custom.accessories_pdf != blank %}
          <a href="{{ product.metafields.custom.accessories_pdf.value.url }}" target="_blank" class="btn btn--black-download btn--full-width-cta">
            📥 {% if request.locale.iso_code == 'sv' %}LADDA NER TILLBEHÖR (PDF){% else %}DOWNLOAD ACCESSORIES (PDF){% endif %}
          </a>
        {% endif %}

        {% if product.metafields.custom.product_gallery_link != blank %}
          <a href="{{ product.metafields.custom.product_gallery_link }}" target="_blank" class="btn btn--black-download btn--full-width-cta">
            📥 {% if request.locale.iso_code == 'sv' %}PRODUKTGALLERI{% else %}PRODUCT GALLERY{% endif %}
          </a>   
        {% endif %}

      </div>
    </div>

  </div>

