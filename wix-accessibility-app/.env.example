# ---- Server ----
PORT=8080
# Public HTTPS origin of this server (no trailing slash). Used in the embedded script and dashboard.
BASE_URL=https://a11y.example.com
# SQLite file location (mount a volume here in Docker)
DB_PATH=./data/app.db
# Brand shown in the widget footer / dashboard
APP_NAME=LumAccess
COMPANY_NAME=Coders Creation
# Landing page for the app ("Powered by LumAccess" in the widget links here)
LANDING_URL=https://coderscreation.com/
# Page where site owners order consulting (audits, remediation, VPAT/ACR...). Receives ?service=&site= params.
SERVICES_URL=https://coderscreation.com/

# ---- Wix Dev Center (https://dev.wix.com -> your app) ----
# OAuth page: App ID and App Secret Key
WIX_APP_ID=
WIX_APP_SECRET=
# Webhooks page: "Public key" (PEM). Newlines may be written as \n.
WIX_PUBLIC_KEY=
# Pricing page: map your plan (vendor product) IDs to internal plans. JSON object.
# Example: {"pro_monthly_plan_id":"pro","business_plan_id":"business"}
WIX_PLAN_MAP={}

# ---- AI alt text (paid plans) ----
ANTHROPIC_API_KEY=
ALT_TEXT_MODEL=claude-opus-5
# Max images generated per background batch and concurrency
ALT_TEXT_CONCURRENCY=2

# ---- Local development ----
# DEV_MODE=1 enables /demo and lets the dashboard run with ?instanceId=dev-site (no Wix signature).
# NEVER enable in production.
DEV_MODE=0
